# DeepWatch — exemplo de variáveis de ambiente
# Copie para .env e ajuste os valores: cp .env.example .env
# O arquivo .env NÃO deve ser versionado (está no .gitignore).

# --- Alertmanager ---
# URL do webhook que recebe os alertas (ex.: crie uma em https://webhook.site).
WEBHOOK_URL=https://webhook.site/00000000-0000-0000-0000-000000000000

# --- Grafana ---
# Usuário e senha do administrador do Grafana.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# --- Aplicação Go (opcionais; valores padrão entre parênteses) ---
# Porta HTTP da aplicação (8080).
APP_PORT=8080
# Nível de log: debug | info | warn | error (info).
LOG_LEVEL=info
# Timeouts do servidor HTTP (aceitam formato Go: 15s, 1m, 500ms).
# APP_READ_TIMEOUT=15s
# APP_READ_HEADER_TIMEOUT=5s
# APP_WRITE_TIMEOUT=15s
# APP_IDLE_TIMEOUT=60s
# APP_SHUTDOWN_TIMEOUT=10s
